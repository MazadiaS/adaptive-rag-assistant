# Copy to .env for local dev, or set these as SECRETS in the Hugging Face Space.
# Provider auto-detects: if OPENAI_API_KEY is set it uses OpenAI, else Gemini.

# --- Option A: OpenAI (you have a key) ---
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_CHAT_MODEL=gpt-4o-mini            # default; handles chat + image vision
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Option B: Google Gemini (free, no card) ---
# GOOGLE_API_KEY=your-gemini-key           # aistudio.google.com/apikey
# CHAT_MODEL=gemini-2.5-flash

# --- Vector DB: leave QDRANT_URL blank to run EMBEDDED locally (no server/Docker) ---
# QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-key

# --- Web-search fallback (optional) ---
# TAVILY_API_KEY=your-tavily-key           # tavily.com, free 1000/mo
