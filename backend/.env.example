# Copy to .env for local dev, or set these as SECRETS in the Hugging Face Space.
GOOGLE_API_KEY=your-gemini-api-key          # aistudio.google.com/apikey  (free, no card)
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-key        # cloud.qdrant.io  (free 1GB, no card)
TAVILY_API_KEY=your-tavily-key              # tavily.com  (free 1000/mo)  -- optional
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=models/text-embedding-004
EMBED_DIM=768
QDRANT_COLLECTION=documents
